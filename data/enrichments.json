{
  "tools": [
    {
      "name": "gobuster",
      "category": "pentest",
      "description": "Fast directory/file and DNS busting tool written in Go.",
      "install": "sudo apt install gobuster",
      "commands": [
        {"task": "directory brute force", "command": "gobuster dir -u http://<target> -w /usr/share/wordlists/dirb/common.txt", "description": "Brute-force directories on a web server."},
        {"task": "find files", "command": "gobuster dir -u http://<target> -w /usr/share/wordlists/dirb/common.txt -x php,txt,html,bak", "description": "Brute-force files with common extensions."},
        {"task": "DNS subdomain brute force", "command": "gobuster dns -d <domain> -w /usr/share/wordlists/dnsrecon/subdomains-top1mil.txt", "description": "Enumerate DNS subdomains."},
        {"task": "vhost brute force", "command": "gobuster vhost -u http://<target> -w /usr/share/wordlists/dnsrecon/subdomains-top1mil.txt", "description": "Brute-force virtual hosts."}
      ],
      "flags": [
        {"flag": "-u", "description": "Target URL", "example": "-u http://10.0.0.1"},
        {"flag": "-w", "description": "Wordlist path", "example": "-w /usr/share/wordlists/dirb/common.txt"},
        {"flag": "-x", "description": "File extensions to search", "example": "-x php,txt"},
        {"flag": "-t", "description": "Number of threads", "example": "-t 50"},
        {"flag": "dir", "description": "Use directory/file enumeration mode"},
        {"flag": "dns", "description": "Use DNS enumeration mode"},
        {"flag": "vhost", "description": "Use VHOST enumeration mode"}
      ],
      "examples": [
        "gobuster dir -u http://10.0.0.1 -w /usr/share/wordlists/dirb/common.txt",
        "gobuster dns -d example.com -w /usr/share/wordlists/dnsrecon/subdomains-top1mil.txt"
      ],
      "safety_notes": "Only run against targets you own or have explicit written authorization to test."
    },
    {
      "name": "ffuf",
      "category": "pentest",
      "description": "Fast web fuzzer written in Go.",
      "install": "sudo apt install ffuf",
      "commands": [
        {"task": "directory fuzzing", "command": "ffuf -u http://<target>/FUZZ -w /usr/share/wordlists/dirb/common.txt", "description": "Fuzz directories on a web server."},
        {"task": "file extension fuzzing", "command": "ffuf -u http://<target>/indexFUZZ -w /usr/share/wordlists/dirb/extensions_common.txt -e .php,.txt,.bak", "description": "Discover backup or alternate file extensions."},
        {"task": "virtual host discovery", "command": "ffuf -u http://<target> -H 'Host: FUZZ.<domain>' -w /usr/share/wordlists/dnsrecon/subdomains-top1mil.txt", "description": "Discover virtual hosts."},
        {"task": "post data fuzzing", "command": "ffuf -u http://<target>/login -X POST -d 'user=FUZZ&pass=FUZZ' -w /usr/share/wordlists/usernames.txt:FUZZ", "description": "Fuzz POST parameters."}
      ],
      "flags": [
        {"flag": "-u", "description": "Target URL with FUZZ keyword", "example": "-u http://target/FUZZ"},
        {"flag": "-w", "description": "Wordlist", "example": "-w /usr/share/wordlists/dirb/common.txt"},
        {"flag": "-H", "description": "Custom header", "example": "-H 'Host: FUZZ.example.com'"},
        {"flag": "-X", "description": "HTTP method", "example": "-X POST"},
        {"flag": "-d", "description": "POST data", "example": "-d 'user=FUZZ'"},
        {"flag": "-e", "description": "Append extensions", "example": "-e .php,.bak"},
        {"flag": "-t", "description": "Threads", "example": "-t 50"},
        {"flag": "-mc", "description": "Match HTTP status codes", "example": "-mc 200,301"}
      ],
      "examples": [
        "ffuf -u http://10.0.0.1/FUZZ -w /usr/share/wordlists/dirb/common.txt",
        "ffuf -u http://10.0.0.1/FUZZ -w /usr/share/wordlists/dirb/common.txt -e .php,.bak -mc 200"
      ],
      "safety_notes": "Only fuzz targets you own or have explicit authorization to test."
    },
